{"nodes": [{"id": "openspec_changes_harden_server_security_proposal_harden_server_security", "label": "Proposal: Harden Server Security", "file_type": "document", "source_file": "openspec/changes/harden-server-security/proposal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The server exposes known security flaws: hardcoded secrets in config/config.js, wildcard CORS, password transported inside the AES token, wrong HTTP statuses (500 instead of 401/403) that can crash the process, and 50mb payload limits that ease DoS. These put credentials and the service at immediate risk."}, {"id": "openspec_changes_harden_server_security_proposal_secure_configuration", "label": "Capability: secure-configuration", "file_type": "concept", "source_file": "openspec/changes/harden-server-security/proposal.md", "source_location": "## Capabilities > New Capabilities", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Loading of secrets and sensitive parameters via environment variables, with startup validation and no secrets in versioned source code."}, {"id": "openspec_changes_harden_server_security_proposal_request_security", "label": "Capability: request-security", "file_type": "concept", "source_file": "openspec/changes/harden-server-security/proposal.md", "source_location": "## Capabilities > New Capabilities", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Restrictive configurable CORS policy, safe payload limits, and authentication responses with correct HTTP status codes without leaking internal details."}], "edges": [{"source": "openspec_changes_harden_server_security_proposal_harden_server_security", "target": "openspec_changes_harden_server_security_proposal_secure_configuration", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/harden-server-security/proposal.md", "source_location": "## Capabilities", "weight": 1.0}, {"source": "openspec_changes_harden_server_security_proposal_harden_server_security", "target": "openspec_changes_harden_server_security_proposal_request_security", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/harden-server-security/proposal.md", "source_location": "## Capabilities", "weight": 1.0}, {"source": "openspec_changes_harden_server_security_proposal_harden_server_security", "target": "openspec_changes_harden_server_security_design_spawn_monkey_patch", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/harden-server-security/proposal.md", "source_location": "## What Changes", "weight": 1.0}], "hyperedges": [{"id": "harden_server_security_change_artifacts", "label": "Harden Server Security OpenSpec Change Artifacts", "nodes": ["openspec_changes_harden_server_security_proposal_harden_server_security", "openspec_changes_harden_server_security_design_harden_server_security", "openspec_changes_harden_server_security_tasks_harden_server_security", "openspec_changes_harden_server_security_specs_request_security_spec_request_security", "openspec_changes_harden_server_security_specs_secure_configuration_spec_secure_configuration", "openspec_changes_harden_server_security__openspec_change_metadata"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/harden-server-security/proposal.md"}]}