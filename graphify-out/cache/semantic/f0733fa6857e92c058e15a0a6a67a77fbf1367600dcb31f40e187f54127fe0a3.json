idence": "INFERRED", "confidence_score": 0.95, "source_file": "openspec/changes/harden-server-security/design.md", "source_location": "## Decisions > D4", "weight": 1.0}, {"source": "openspec_changes_harden_server_security_design_d5_direct_removals", "target": "openspec_changes_harden_server_security_specs_secure_configuration_spec_network_params", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "openspec/changes/harden-server-security/design.md", "source_location": "## Decisions > D5", "weight": 1.0}], "hyperedges": [{"id": "environment_based_configuration_flow", "label": "Environment-Based Secret Configuration Flow", "nodes": ["openspec_changes_harden_server_security_design_d1_native_env_reading", "openspec_changes_harden_server_security_specs_secure_configuration_spec_env_secrets", "openspec_changes_harden_server_security_specs_secure_configuration_spec_fail_fast_missing_secret", "openspec_changes_harden_server_security_specs_secure_configuration_spec_env_example", "openspec_changes_harden_server_security_design_key_request_auth", "readme_env_vars"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "openspec/changes/harden-server-security/design.md"}]}