# =====================================================================
# Node Server — variáveis de ambiente
# Copie este arquivo para .env (não versionado) ou exporte no shell.
# =====================================================================

# --- Obrigatórias -----------------------------------------------------
# Chave usada para criptografar/descriptografar o token de autenticação
# das requisições. O servidor NÃO inicia sem ela.
KEY_REQUEST_AUTH=change-me

# --- Servidor ---------------------------------------------------------
# Porta HTTP do servidor (default: 9090)
PORT=9090
# Limite do corpo das requisições JSON/urlencoded (default: 1mb)
BODY_LIMIT=1mb
# Origens permitidas para CORS, separadas por vírgula.
# Vazio = nenhum cabeçalho CORS emitido.
CORS_ORIGINS=http://localhost:9090

# --- LDAP -------------------------------------------------------------
LDAP_URL=ldap://0.0.0.0:389
LDAP_BASE_DN=dc=domain,dc=local
LDAP_USERNAME=user@domain.com
LDAP_PASSWORD=change-me

# --- E-mail (SMTP) ----------------------------------------------------
# Sem MAIL_USER/MAIL_PASS o envio de e-mail é desabilitado automaticamente.
MAIL_HOST=smtp.domain.com.br
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@domain.com.br
MAIL_TO=contact@domain.com.br

# --- Gateway SOA ------------------------------------------------------
# Valores usados anteriormente em produção: 10.200.1.190 / 7101
GATEWAY_HOST=
GATEWAY_PORT=
