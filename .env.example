# =====================================================================
# Node Server — variáveis de ambiente
# Copie este arquivo para .env (não versionado) ou exporte no shell.
# =====================================================================

# --- Obrigatórias -----------------------------------------------------
# Chave usada para assinar (HMAC-SHA256) o token de autenticação das
# requisições. Use um valor longo e aleatório (>= 32 caracteres), ex.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# O servidor NÃO inicia sem ela.
KEY_REQUEST_AUTH=change-me

# --- Servidor ---------------------------------------------------------
# Porta HTTP do servidor (default: 9090)
PORT=9090
# Limite do corpo das requisições JSON/urlencoded (default: 1mb)
BODY_LIMIT=1mb
# Origens permitidas para CORS, separadas por vírgula.
# Vazio = nenhum cabeçalho CORS emitido.
CORS_ORIGINS=http://localhost:9090
# Confiar nos cabeçalhos X-Forwarded-* (true apenas atrás de proxy reverso)
TRUST_PROXY=false
# Incluir stack trace/detalhes internos nas respostas de erro (apenas desenvolvimento)
EXPOSE_ERROR_DETAILS=false
# Limite global de requisições por IP na janela (0 = desabilitado)
RATE_LIMIT_MAX=0
RATE_LIMIT_WINDOW_MS=900000
# Tamanho máximo de cada arquivo em multipart/form-data, em bytes (default: 10mb)
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_MAX_FIELDS=1000

# --- Autenticação -----------------------------------------------------
# Validade do token de autenticação, em segundos (default: 8 horas)
TOKEN_EXPIRES_IN=28800
# Tentativas de login por IP dentro da janela (0 = desabilitado)
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_LOGIN_WINDOW_MS=900000

# --- Banco de dados (JDBC) --------------------------------------------
# Tipo: MARIADB, MYSQL, POSTGRESQL, ORACLEDB ou INFORMIX
DB_TYPE=MARIADB
DB_HOST=localhost
# Porta (default: a padrão do DB_TYPE)
DB_PORT=
DB_NAME=gSenseX
# Nome do serviço (apenas ORACLEDB)
DB_SERVICE=
DB_USER=root
DB_PASSWORD=
# URL JDBC completa (opcional; substitui host/porta/banco) e classe do driver (opcional)
DB_URL=
DB_DRIVER=
# Diretório adicional com drivers JDBC (.jar), além de common/drivers
DB_DRIVERS_DIR=
# Túnel SSH até o banco (opcional)
DB_SSH=false
DB_SSH_HOST=
DB_SSH_PORT=22
DB_SSH_USERNAME=
DB_SSH_PASSWORD=
DB_SSH_DST_HOST=
DB_SSH_DST_PORT=
DB_SSH_LOCAL_PORT=

# --- LDAP -------------------------------------------------------------
LDAP_URL=ldap://0.0.0.0:389
LDAP_BASE_DN=dc=domain,dc=local
LDAP_USERNAME=user@domain.com
LDAP_PASSWORD=change-me

# --- E-mail (SMTP) ----------------------------------------------------
# Sem MAIL_USER/MAIL_PASS o envio de e-mail é desabilitado automaticamente.
MAIL_HOST=smtp.domain.com.br
MAIL_PORT=587
# true = TLS implícito (porta 465); false = STARTTLS na porta 587
MAIL_SECURE=false
# Exige STARTTLS quando MAIL_SECURE=false (credenciais nunca trafegam em texto puro)
MAIL_REQUIRE_TLS=true
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@domain.com.br
MAIL_TO=contact@domain.com.br

# --- Gateway SOA ------------------------------------------------------
# Valores usados anteriormente em produção: 10.200.1.190 / 7101
GATEWAY_HOST=
GATEWAY_PORT=
