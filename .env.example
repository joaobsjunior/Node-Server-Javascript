# =====================================================================
# Node Server — variáveis de ambiente
# Copie este arquivo para .env (não versionado) ou exporte no shell.
# =====================================================================

# --- Obrigatórias -----------------------------------------------------
# Chave usada para assinar (HMAC-SHA256) o token de autenticação das
# requisições. O servidor NÃO inicia sem ela. Use um valor aleatório com
# pelo menos 32 caracteres, ex.: openssl rand -base64 48
KEY_REQUEST_AUTH=change-me

# --- Servidor ---------------------------------------------------------
# Porta HTTP do servidor (default: 9090)
PORT=9090
# Limite do corpo das requisições JSON/urlencoded (default: 1mb)
BODY_LIMIT=1mb
# Origens permitidas para CORS, separadas por vírgula.
# Vazio = nenhum cabeçalho CORS emitido.
CORS_ORIGINS=http://localhost:9090
# Timeout de inatividade do socket por requisição, em ms (default: 120000; 0 = default do Node)
REQUEST_TIMEOUT_MS=120000
# Atrás de proxy reverso: número de saltos confiáveis (ex.: 1) ou lista de IPs.
# Necessário para que rate limit e logs usem o IP real do cliente.
TRUST_PROXY=
# Inclui stack trace nas respostas de erro. Apenas para depuração local. (default: false)
EXPOSE_ERROR_DETAILS=false

# --- Autenticação -----------------------------------------------------
# Tempo de vida do token, em segundos (default: 28800 = 8h)
TOKEN_TTL_SECONDS=28800

# --- Rate limiting ----------------------------------------------------
# Limite global por IP (default: 300 requisições por 60000 ms)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Limite de tentativas de login por IP (default: 10 falhas por 900000 ms = 15 min)
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# --- Upload (multipart/form-data) ------------------------------------
# Limites em bytes / quantidade (defaults: 10 MB por arquivo, 1 MB de campos, 100 campos, 10 arquivos)
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_MAX_FIELDS_SIZE=1048576
UPLOAD_MAX_FIELDS=100
UPLOAD_MAX_FILES=10

# --- LDAP -------------------------------------------------------------
LDAP_URL=ldap://0.0.0.0:389
LDAP_BASE_DN=dc=domain,dc=local
LDAP_USERNAME=user@domain.com
LDAP_PASSWORD=change-me

# --- E-mail (SMTP) ----------------------------------------------------
# Sem MAIL_USER/MAIL_PASS o envio de e-mail é desabilitado automaticamente.
MAIL_HOST=smtp.domain.com.br
MAIL_PORT=587
# TLS implícito (porta 465). Com false usa STARTTLS quando disponível.
MAIL_SECURE=false
# Recusa conexão se o servidor não oferecer STARTTLS.
MAIL_REQUIRE_TLS=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@domain.com.br
MAIL_TO=contact@domain.com.br

# --- Gateway SOA ------------------------------------------------------
GATEWAY_HOST=
GATEWAY_PORT=
